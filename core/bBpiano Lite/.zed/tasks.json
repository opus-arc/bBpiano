[
  {
    "label": "bbpl: Build Debug (Xcode)",
    "command": "xcodebuild",
    "args": [
      "-project",
      "bbpl.xcodeproj",
      "-target",
      "bbpl",
      "-configuration",
      "Debug",
      "build",
      "CODE_SIGNING_ALLOWED=NO"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "bbpl: Build Release (Xcode)",
    "command": "xcodebuild",
    "args": [
      "-project",
      "bbpl.xcodeproj",
      "-target",
      "bbpl",
      "-configuration",
      "Release",
      "build",
      "CODE_SIGNING_ALLOWED=NO"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "bbpl: Refresh clangd from Xcode",
    "command": "./scripts/dev/bootstrap_zed_cpp.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "bbpl: Smoke Test (--help)",
    "command": "./build/Debug/bbpl",
    "args": ["--help"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
