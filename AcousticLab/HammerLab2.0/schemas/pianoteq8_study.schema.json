{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hammerlab.local/schemas/pianoteq8_study.schema.json",
  "title": "HammerLab2.0 Pianoteq 8 study",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "output_directory",
    "engine",
    "preset",
    "render",
    "midi",
    "fixed_parameters",
    "heartbeat"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "output_directory": {"type": "string", "minLength": 1},
    "preset": {"type": "string", "minLength": 1},
    "engine": {
      "type": "object",
      "required": [
        "wine_path",
        "bottle",
        "executable_windows",
        "executable_native_path",
        "expected_version"
      ],
      "properties": {
        "wine_path": {"type": "string", "minLength": 1},
        "bottle": {"type": "string", "minLength": 1},
        "executable_windows": {"type": "string", "minLength": 1},
        "executable_native_path": {"type": "string", "minLength": 1},
        "expected_version": {"type": "string", "pattern": "^8\\.4\\.3/"}
      },
      "additionalProperties": true
    },
    "render": {
      "type": "object",
      "required": ["sample_rate_hz", "bit_depth", "channels"],
      "properties": {
        "sample_rate_hz": {"const": 44100},
        "bit_depth": {"enum": [16, 24, 32]},
        "channels": {"enum": [1, 2]},
        "dither": {"type": "boolean"},
        "normalize": {"type": "boolean"},
        "reject_clipping": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "heartbeat": {
      "type": "object",
      "required": ["midi_note", "delta", "repeats", "groups"],
      "properties": {
        "midi_note": {"type": "integer", "minimum": 0, "maximum": 127},
        "delta": {"type": "number", "exclusiveMinimum": 0},
        "repeats": {"type": "integer", "minimum": 1},
        "validation": {
          "type": "object",
          "required": [
            "maximum_repeat_normalized_rms",
            "minimum_effect_normalized_rms",
            "minimum_effect_to_repeat_ratio"
          ],
          "properties": {
            "maximum_repeat_normalized_rms": {
              "type": "number",
              "minimum": 0
            },
            "minimum_effect_normalized_rms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minimum_effect_to_repeat_ratio": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "groups": {"type": "array", "minItems": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
